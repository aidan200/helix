{
  "name": "helix",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun apps/daemon/src/main.ts",
    "audit:assert": "bun scripts/audit-assert.ts",
    "audit:a11y": "node scripts/perf-a11y-audit.mjs",
    "fetch:rg": "bun scripts/fetch-rg.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "dev:shell": "bun run --cwd=apps/shell dev",
    "dev:desktop": "bun scripts/dev-desktop.ts",
    "test": "bun test apps/daemon",
    "test:shell": "vitest run apps/shell",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:e2e:x2": "playwright test -c playwright.e2e.config.ts && playwright test -c playwright.e2e.config.ts",
    "test:protocol": "cd packages/protocol && bun test",
    "typecheck": "bash scripts/typecheck-all.sh",
    "verify": "bun run typecheck && bun run test && bun run test:protocol && bun run test:shell",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@helix/protocol": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
