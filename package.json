{
  "name": "helix",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun apps/daemon/src/main.ts",
    "audit:assert": "bun scripts/audit-assert.ts",
    "audit:a11y": "node scripts/perf-a11y-audit.mjs",
    "dev:shell": "bun run --cwd=apps/shell dev",
    "test": "bun test apps/daemon",
    "test:shell": "vitest run apps/shell",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:e2e:x2": "playwright test -c playwright.e2e.config.ts && playwright test -c playwright.e2e.config.ts",
    "test:protocol": "cd packages/protocol && bun test"
  },
  "devDependencies": {
    "@helix/protocol": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
