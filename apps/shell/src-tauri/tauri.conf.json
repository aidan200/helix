{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "helix",
  "version": "0.0.0",
  "identifier": "dev.helix.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "binaries/helix-daemon"
    ],
    "resources": {
      "resources/bin/rg": "bin/rg",
      "resources/codegraph": "codegraph"
    },
    "macOS": {
      "entitlements": null
    }
  }
}